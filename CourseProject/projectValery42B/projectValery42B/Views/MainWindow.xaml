<Window x:Class="projectValery42B.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projectValery42B"
        mc:Ignorable="d"
        Title="Customer Search App" Height="700" Width="800"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="14">
    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Margin="20" Background="White" Padding="20" >
        <StackPanel Margin="20">

            <!-- Заглавие -->
            <TextBlock Text="Търсене на клиенти" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#334155"
                       Margin="0,0,0,15"
                       HorizontalAlignment="Center"
            />

            <!-- Инструкции -->
            <TextBlock Text="Въведете ID-та (разделени с интервал):" 
                       Foreground="#475569"
                       Margin="0,0,0,5"
            />

            <!-- Текстово поле -->
            <TextBox x:Name="IdsBox"
                     Text="1 3 5"
                     FontSize="14"
                     Padding="6"
                     BorderBrush="#94A3B8"
                     BorderThickness="1"
                     Margin="0,0,0,15"
                     Background="#F1F5F9"
            />

            <!-- Бутоните -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="ButtonSearch"
                        Content="Търси клиенти"
                        Width="160" Height="40"
                        FontWeight="Bold"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Click="ButtonSearch_Click"
                        Cursor="Hand"
                />

                <Button x:Name="ButtonExit"
                        Content="Изход"
                        Width="100" Height="40"
                        FontWeight="Bold"
                        Background="#EF4444"
                        Foreground="White"
                        BorderBrush="#DC2626"
                        BorderThickness="1"
                        Click="ButtonExit_Click"
                        Cursor="Hand"
                />
            </StackPanel>

            <!-- Резултати -->
            <TextBlock Text="Списък с клиенти:" 
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#1E293B"
                       Margin="0,10,0,5"
            />

            <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC">
                <ListBox x:Name="ResultList" 
                         Height="220" 
                         FontSize="14"
                         Foreground="#334155"
                         BorderThickness="0"
                         Background="Transparent"
                />
            </Border>

            <TextBlock Text="© 2025, Паралелно търсене на клиенти – демо проект"
                       FontSize="12"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
            />
        </StackPanel>
    </Border>
</Window>
