<Window x:Class="DotnetAsyncPrgm04.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DotnetAsyncPrgm04"
        mc:Ignorable="d"
        Title="Word Counter" Height="450" Width="800">
    <StackPanel Margin="10">

        <TextBlock Text="Изберете файл (big.txt):" FontWeight="Bold"/>
        <Button x:Name="ButtonLoad" Content="Зареди и анализирай" Width="200" Height="35" 
                Margin="0,5,0,10" Click="ButtonLoad_Click"/>

        <ListBox x:Name="ResultList" Height="330" FontFamily="Consolas" />

    </StackPanel>
</Window>
