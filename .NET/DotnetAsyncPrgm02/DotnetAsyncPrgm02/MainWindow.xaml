<Window x:Class="DotnetAsyncPrgm02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DotnetAsyncPrgm02"
        mc:Ignorable="d"
        Title="Http Delay Test" Height="450" Width="800">
    <StackPanel Margin="20" VerticalAlignment="Center">

        <TextBlock Text="Въведете закъснение (сек.):" />
        <TextBox x:Name="DelayBox" Text="3" Margin="0,5,0,10" />

        <TextBlock Text="Максимално време за чакане (сек.):" />
        <TextBox x:Name="TimeoutBox" Text="5" Margin="0,5,0,10" />

        <Button x:Name="ButtonStart" Content="Изпрати заявка" Width="180" Height="35"
                Click="ButtonStart_Click" HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <TextBlock Text="Резултат:" FontWeight="Bold"/>
        <TextBox x:Name="ResultBox" Height="100" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</Window>
