<Window x:Class="DotnetAsyncPrgm01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DotnetAsyncPrgm01"
        mc:Ignorable="d"
        Title="Async Demo" Height="200" Width="300">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="ButtonStart" Content="Старт" Width="150" Height="40" Click="ButtonStart_ClickAsync"/>
        <Label x:Name="LabelOutput" FontSize="24" HorizontalContentAlignment="Center" Margin="10"/>
    </StackPanel>
</Window>
